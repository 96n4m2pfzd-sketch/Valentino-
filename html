<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MiniFacebook</title>
    <!-- Tailwind CSS per uno stile rapido e moderno -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-[#f0f2f5] font-sans text-gray-800">

    <!-- BARRA DI NAVIGAZIONE SUPERIORE -->
    <header class="bg-white h-14 shadow fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-4">
        <!-- Logo e Ricerca -->
        <div class="flex items-center space-x-2">
            <div class="bg-[#1877f2] text-white w-10 h-10 rounded-full flex items-center justify-center font-bold text-2xl">f</div>
            <div class="hidden md:flex bg-[#f0f2f5] items-center rounded-full px-3 py-2 space-x-2 w-60">
                <i class="fa-solid fa-magnifying-glass text-gray-500"></i>
                <input type="text" placeholder="Cerca su MiniFacebook" class="bg-transparent outline-none text-sm w-full">
            </div>
        </div>

        <!-- Icone Centrali (Feed, Video, Gruppi) -->
        <div class="flex space-x-2 md:space-x-6 h-full items-center">
            <button class="h-full px-4 md:px-8 border-b-4 border-[#1877f2] text-[#1877f2] text-xl flex items-center"><i class="fa-solid fa-house"></i></button>
            <button class="h-full px-4 md:px-8 text-gray-500 hover:bg-gray-100 text-xl flex items-center"><i class="fa-solid fa-tv"></i></button>
            <button class="h-full px-4 md:px-8 text-gray-500 hover:bg-gray-100 text-xl flex items-center"><i class="fa-solid fa-users"></i></button>
        </div>

        <!-- Profilo e Menu Utente -->
        <div class="flex items-center space-x-2">
            <div class="bg-gray-200 w-10 h-10 rounded-full flex items-center justify-center font-bold text-gray-600">TU</div>
        </div>
    </header>

    <!-- CORPO PRINCIPALE (Layout a 3 Colonne) -->
    <div class="pt-16 flex justify-between max-w-7xl mx-auto">

        <!-- COLONNA SINISTRA (Menu Rapido) -->
        <div class="hidden lg:block w-1/4 p-4 sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto">
            <ul class="space-y-2">
                <li class="flex items-center space-x-3 p-2 hover:bg-gray-200 rounded-lg cursor-pointer font-semibold">
                    <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white">TU</div>
                    <span>Il tuo Profilo</span>
                </li>
                <li class="flex items-center space-x-3 p-2 hover:bg-gray-200 rounded-lg cursor-pointer text-gray-700">
                    <i class="fa-solid fa-user-group text-blue-500 text-xl w-8 text-center"></i>
                    <span>Amici</span>
                </li>
                <li class="flex items-center space-x-3 p-2 hover:bg-gray-200 rounded-lg cursor-pointer text-gray-700">
                    <i class="fa-solid fa-clock-rotate-left text-blue-400 text-xl w-8 text-center"></i>
                    <span>Ricordi</span>
                </li>
                <li class="flex items-center space-x-3 p-2 hover:bg-gray-200 rounded-lg cursor-pointer text-gray-700">
                    <i class="fa-solid fa-bookmark text-purple-500 text-xl w-8 text-center"></i>
                    <span>Salvati</span>
                </li>
            </ul>
        </div>

        <!-- COLONNA CENTRALE (Feed dei Post) -->
        <div class="w-full lg:w-2/4 p-4 max-w-xl mx-auto">
            
            <!-- Box Creazione Post -->
            <div class="bg-white p-4 rounded-lg shadow mb-4">
                <div class="flex items-center space-x-2 pb-3 border-b">
                    <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white font-bold">TU</div>
                    <input type="text" id="postInput" placeholder="A cosa stai pensando, Tu?" class="bg-[#f0f2f5] hover:bg-gray-200 transition p-2.5 rounded-full w-full outline-none cursor-pointer">
                </div>
                <div class="flex justify-between pt-3">
                    <button onclick="createPost()" class="w-full bg-[#1877f2] text-white font-semibold py-2 rounded-lg hover:bg-blue-600 transition">Pubblica</button>
                </div>
            </div>

            <!-- Contenitore dei Post Dinamici -->
            <div id="feedContainer" class="space-y-4">
                <!-- Post di Esempio -->
                <div class="bg-white p-4 rounded-lg shadow">
                    <div class="flex items-center mb-2">
                        <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center text-white font-bold mr-3">MR</div>
                        <div>
                            <h3 class="font-bold text-gray-800">Mario Rossi</h3>
                            <span class="text-xs text-gray-500">2 ore fa</span>
                        </div>
                    </div>
                    <p class="text-gray-700 mb-3">Benvenuti sulla mia nuova bacheca in stile Facebook creata in HTML e JavaScript! 🚀</p>
                    <div class="border-t border-b py-1 flex justify-around text-gray-600 font-semibold text-sm">
                        <button onclick="likePost(this)" class="hover:bg-gray-100 w-full py-1.5 rounded flex items-center justify-center space-x-2"><i class="fa-regular fa-thumbs-up"></i> <span>Mi piace (3)</span></button>
                        <button class="hover:bg-gray-100 w-full py-1.5 rounded flex items-center justify-center space-x-2"><i class="fa-regular fa-comment"></i> <span>Commenta</span></button>
                    </div>
                </div>
            </div>

        </div>

        <!-- COLONNA DESTRA (Contatti / Chat) -->
        <div class="hidden lg:block w-1/4 p-4 sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto">
            <h4 class="font-semibold text-gray-500 mb-3">Contatti</h4>
            <ul class="space-y-3">
                <li class="flex items-center space-x-3 cursor-pointer hover:bg-gray-200 p-2 rounded-lg">
                    <div class="relative">
                        <div class="w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center text-white text-sm font-bold">LB</div>
                        <div class="w-3 h-3 bg-green-500 rounded-full absolute bottom-0 right-0 border-2 border-white"></div>
                    </div>
                    <span class="font-medium text-sm">Luigi Bianchi</span>
                </li>
                <li class="flex items-center space-x-3 cursor-pointer hover:bg-gray-200 p-2 rounded-lg">
                    <div class="relative">
                        <div class="w-8 h-8 bg-yellow-500 rounded-full flex items-center justify-center text-white text-sm font-bold">AV</div>
                        <div class="w-3 h-3 bg-green-500 rounded-full absolute bottom-0 right-0 border-2 border-white"></div>
                    </div>
                    <span class="font-medium text-sm">Anna Verdi</span>
                </li>
            </ul>
        </div>

    </div>

    <!-- SCRIPT JAVASCRIPT PER GESTIRE I POST E I LIKE -->
    <script>
        function createPost() {
            const input = document.getElementById('postInput');
            const content = input.value.trim();

            if (!content) {
                alert("Scrivi qualcosa prima di pubblicare!");
                return;
            }

            const feed = document.getElementById('feedContainer');

            // Crea l'elemento HTML del post
            const postDiv = document.createElement('div');
            postDiv.className = "bg-white p-4 rounded-lg shadow";
            postDiv.innerHTML = `
                <div class="flex items-center mb-2">
                    <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white font-bold mr-3">TU</div>
                    <div>
                        <h3 class="font-bold text-gray-800">Tu</h3>
                        <span class="text-xs text-gray-500">Proprio ora</span>
                    </div>
                </div>
                <p class="text-gray-700 mb-3">${content}</p>
                <div class="border-t border-b py-1 flex justify-around text-gray-600 font-semibold text-sm">
                    <button onclick="likePost(this)" class="hover:bg-gray-100 w-full py-1.5 rounded flex items-center justify-center space-x-2"><i class="fa-regular fa-thumbs-up"></i> <span>Mi piace (0)</span></button>
                    <button onclick="toggleComments(this)" class="hover:bg-gray-100 w-full py-1.5 rounded flex items-center justify-center space-x-2"><i class="fa-regular fa-comment"></i> <span>Commenta</span></button>
                </div>
                <div class="comment-section hidden mt-3 pt-2 border-t">
                    <div class="flex space-x-2 mb-2">
                        <input type="text" placeholder="Scrivi un commento..." class="comment-input bg-[#f0f2f5] text-sm p-2 rounded-full w-full outline-none">
                        <button onclick="addComment(this)" class="bg-blue-500 text-white px-3 py-1 rounded-full text-sm">Invia</button>
                    </div>
                    <div class="comments-list space-y-2 mt-2"></div>
                </div>
            `;

            // Aggiunge il post in cima al feed
            feed.prepend(postDiv);
            input.value = "";
        }

        // Funzione Mi Piace
        function likePost(button) {
            const span = button.querySelector('span');
            let currentLikes = parseInt(span.textContent.replace('Mi piace (', '').replace(')', ''));
            currentLikes++;
            span.textContent = `Mi piace (${currentLikes})`;
            button.classList.add('text-blue-600');
        }

        // Mostra/Nascondi sezione commenti
        function toggleComments(button) {
            const postCard = button.closest('.bg-white');
            const commentSection = postCard.querySelector('.comment-section');
            commentSection.classList.toggle('hidden');
        }

        // Aggiungi un commento
        function addComment(button) {
            const commentSection = button.closest('.comment-section');
            const input = commentSection.querySelector('.comment-input');
            const commentText = input.value.trim();

            if (!commentText) return;

            const list = commentSection.querySelector('.comments-list');
            const commentDiv = document.createElement('div');
            commentDiv.className = "bg-gray-100 p-2 rounded-lg text-sm flex items-center space-x-2";
            commentDiv.innerHTML = `<strong>Tu:</strong> <span>${commentText}</span>`;
            
            list.appendChild(commentDiv);
            input.value = "";
        }
    </script>
</body>
</html>
